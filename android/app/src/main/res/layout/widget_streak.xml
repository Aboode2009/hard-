<?xml version="1.0" encoding="utf-8"?>
<!--
    2x2 streak widget — design: widget-1-streak-2x2.svg.
    Layout direction is set at runtime from the app's language (RTL for Arabic),
    so "start" below means right in Arabic and left in English.
    autoSize keeps single-line text from being cut on small launcher cells
    (Android 8+; older versions use the fixed sizes).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: brand at start, "Day 9 of 21" at end -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/streak_brand"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/tajawal_extrabold"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="HARD 21"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/streak_day"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/tajawal_regular"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Body: progress ring at start, streak number beside it -->
        <LinearLayout
            android:id="@+id/streak_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp">

                <ImageView
                    android:id="@+id/streak_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_flame" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/streak_count"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:autoSizeMaxTextSize="40sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/tajawal_extrabold"
                    android:gravity="start|bottom"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/streak_unit"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/tajawal_regular"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Signed out / out of date: replaces the body -->
        <TextView
            android:id="@+id/streak_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/tajawal_bold"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Narrow cells only (see StreakWidgetProvider): unit and day on one
             full-width line, instead of squeezed beside the number/brand. -->
        <TextView
            android:id="@+id/streak_sub"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginBottom="4dp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/tajawal_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/streak_button"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/widget_button_bg"
            android:fontFamily="@font/tajawal_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
